// Signing of the Development configuration.
//
// Without Local.xcconfig, builds are signed to run locally (ad hoc). An ad-hoc signature changes with
// each build, so macOS asks again for access to keychain items that an earlier build saved.
// A Local.xcconfig with your team gives the builds a stable signature, for example:
//
//   DEVELOPMENT_TEAM = <team ID>
//   CODE_SIGN_IDENTITY = Apple Development

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

#include? "Local.xcconfig"
